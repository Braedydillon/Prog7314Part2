<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors login.xml: logo, title, bordered fields, yellow button, text link -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="24dp">

        <ImageView
            android:layout_width="244dp"
            android:layout_height="174dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/unify" />

        <TextView
            android:id="@+id/Register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/register"
            android:textColor="#000000"
            android:textSize="28sp" />

        <EditText
            android:id="@+id/regname"
            android:layout_width="319dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:autofillHints="givenName"
            android:background="@drawable/text_border"
            android:hint="@string/name"
            android:inputType="textPersonName|textCapWords"
            android:padding="12dp" />

        <EditText
            android:id="@+id/regsurname"
            android:layout_width="319dp"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:autofillHints="familyName"
            android:background="@drawable/text_border"
            android:hint="@string/surname"
            android:inputType="textPersonName|textCapWords"
            android:padding="12dp" />

    <Button
        android:id="@+id/regregister"
        android:layout_width="317dp"
        android:layout_height="51dp"
        android:text="@string/register"
        app:backgroundTint="#CDDE31"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.489"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.65" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegGoogleSignIn"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="317dp"
        android:layout_height="51dp"
        android:layout_marginTop="12dp"
        android:text="@string/google_login_button"
        android:textColor="@color/black"
        app:icon="@drawable/googleg_standard_color_18"
        app:iconSize="20dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/regregister" />

    <Button
        android:id="@+id/reglogin"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="275dp"
        android:layout_height="70dp"
        android:text="@string/already_have_an_account_login"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRegGoogleSignIn"
        app:layout_constraintVertical_bias="0.463" />

        <Button
            android:id="@+id/regregister"
            android:layout_width="317dp"
            android:layout_height="51dp"
            android:layout_marginTop="24dp"
            android:text="@string/register"
            android:textColor="@color/black"
            app:backgroundTint="@color/brand_yellow" />

        <Button
            android:id="@+id/reglogin"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="275dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:text="@string/already_have_an_account_login"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
