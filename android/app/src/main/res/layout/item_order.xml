<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Unify.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/streak_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Order #12" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/streak_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Processing" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="13sp"
            tools:text="Placed on: 2 Nov 2026" />

        <TextView
            android:id="@+id/tvOrderEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="13sp"
            tools:text="Est. Delivery: 3-5 Business Days" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/streak_card_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderItemsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/streak_text_secondary"
                android:textSize="13sp"
                tools:text="3 Items" />

            <TextView
                android:id="@+id/tvOrderCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/streak_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Total: R 499.00" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
