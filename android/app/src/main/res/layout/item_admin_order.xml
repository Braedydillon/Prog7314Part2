<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Unify.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/streak_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Order #1001" />

            <TextView
                android:id="@+id/tvAdminOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/text_border"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="SHIPPED" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminCustomerId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="13sp"
            tools:text="Customer ID: usr_xyz123" />

        <TextView
            android:id="@+id/tvAdminOrderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="13sp"
            tools:text="Placed on: 2025-05-10" />

        <TextView
            android:id="@+id/tvAdminOrderEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="13sp"
            tools:text="Est. Delivery: 3-5 Business Days" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/streak_card_stroke" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_order_items_header"
            android:textColor="@color/streak_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminOrderItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/streak_text_primary"
            android:textSize="14sp"
            tools:text="• Wireless Headphones (1 x R 850.00 = R 850.00)\n• Running Shoes (2 x R 450.00 = R 900.00)" />

        <TextView
            android:id="@+id/tvAdminOrderPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Points spent: 50 (R 5.00 discount)"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminOrderTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/streak_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Total: R 1,750.00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeStatus"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_change_status" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
