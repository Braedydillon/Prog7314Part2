<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Unify.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/streak_card_bg</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/streak_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Unify.SectionHeader" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/streak_text_secondary</item>
    </style>

    <style name="ShapeAppearance.Unify.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded-square image inside cards -->
    <style name="ShapeAppearance.Unify.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Large bold page title used at the top of every screen -->
    <style name="Unify.ScreenTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/streak_text_primary</item>
    </style>

    <!-- Main call-to-action: yellow fill, dark text (matches the login button) -->
    <style name="Unify.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_yellow</item>
        <item name="android:textColor">@color/streak_text_primary</item>
        <item name="iconTint">@color/streak_text_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Secondary action: outlined, dark text (matches the Google/biometric buttons) -->
    <style name="Unify.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/streak_text_primary</item>
        <item name="iconTint">@color/streak_text_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
